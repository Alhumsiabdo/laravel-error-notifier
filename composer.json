{
  "name": "alhumsi/laravel-error-notifier",
  "description": "Laravel package for actionable error notifications and auto actions",
  "type": "library",
  "license": "MIT",
  "authors": [
    { "name": "Abdullah ALhumsi", "email": "abdullah.alhumsi9@gmail.com" }
  ],
  "autoload": {
    "psr-4": {
      "alhumsi\\ErrorNotifier\\": "src/"
    }
  },
  "require": {
    "php": ">=8.2",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "analyze": "vendor/bin/phpstan analyse --memory-limit=1G"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0|^11.5|^12.0",
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "mockery/mockery": "^1.6",
    "larastan/larastan": "^2.9|^3.0"
  },
  "autoload-dev": {
    "psr-4": {
      "alhumsi\\ErrorNotifier\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["alhumsi\\ErrorNotifier\\ErrorNotifierServiceProvider"]
    }
  }
}
