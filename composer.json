{
  "name": "alhumsi/laravel-error-notifier",
  "description": "Laravel package for actionable error notifications and auto actions",
  "type": "library",
  "license": "MIT",
  "authors": [
    { "name": "Abdullah ALhumsi", "email": "abdullah.alhumsi9@gmail.com" }
  ],
  "autoload": {
    "psr-4": {
      "alhumsi\\ErrorNotifier\\": "src/"
    }
  },
  "require": {
    "php": ">=8.1",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "orchestra/testbench": "^8.0",
    "mockery/mockery": "^1.6"
  },
  "autoload-dev": {
    "psr-4": {
      "alhumsi\\ErrorNotifier\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["alhumsi\\ErrorNotifier\\ErrorNotifierServiceProvider"]
    }
  }
}
